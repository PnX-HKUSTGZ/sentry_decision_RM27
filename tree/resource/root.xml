<?xml version="1.0"?>
<!--
  资源 / 复活任务（与导航任务并行求值，输出 kResourceRequest 意图）。
  进入条件：每 tick；退出条件：-。
  优先级：立即复活 > 免费复活 > 远程兑换血量 > 本地兑换发弹量 > 远程兑换发弹量。
  前置条件：血量按规则只允许脱战远程兑换；本地兑换发弹量需占领补给区 / 基地 / 前哨站
  增益点；不在增益点时可在脱战下远程兑换发弹量。
-->
<root BTCPP_format="4" main_tree_to_execute="ResourceRoot">
  <BehaviorTree ID="ResourceRoot">
    <ReactiveFallback name="ResourcePriority">
      <Sequence name="InstantRevive">
        <IfCanInstantResurrect/>
        <RequestInstantRevive/>
      </Sequence>
      <Sequence name="FreeRevive">
        <IfCanFreeResurrect/>
        <RequestFreeRevive/>
      </Sequence>
      <!-- <Sequence name="RemoteHpExchange">
        <IfLowHp hp_key="resource.hp_exchange_threshold"/>
        <IfDisengaged/>
        <IfCoinsAtLeast coins_key="resource.min_coins"/>
        <RequestRemoteHpExchange times_key="resource.remote_hp_times"/>
      </Sequence> -->
      <Sequence name="LocalAmmoExchange">
        <IfLowAmmo ammo_key="nav.low_ammo"/>
        <IfOccupyingGainPoint/>
        <IfCoinsAtLeast coins_key="resource.min_coins"/>
        <RequestAmmoExchange amount_key="resource.exchange_ammo_step"/>
      </Sequence>
      <!-- <Sequence name="RemoteAmmoExchange">
        <IfLowAmmo ammo_key="nav.low_ammo"/>
        <IfDisengaged/>
        <IfNotOccupyingGainPoint/>
        <IfCoinsAtLeast coins_key="resource.remote_ammo_min_coins"/>
        <RequestRemoteAmmoExchange times_key="resource.remote_ammo_times"/>
      </Sequence> -->
    </ReactiveFallback>
  </BehaviorTree>
</root>
