<?xml version="1.0"?>
<!--
  任务：低血撤退回补给点。
  进入条件：己方血量 <= 配置 nav.retreat_hp。
  退出条件：血量恢复后本分支条件不再成立，由高优先级 ReactiveFallback 抢占。
  抢占关系：作为 MissionPriority 的第一个孩子，抢占巡逻等低优先级任务。
-->
<root BTCPP_format="4" main_tree_to_execute="MissionRetreat">
  <BehaviorTree ID="MissionRetreat">
    <Sequence name="RetreatSequence">
      <IfLowHp hp_key="nav.retreat_hp"/>
      <SubTree ID="GotoNamedPoint" target_point="home" __shared_blackboard="true"/>
    </Sequence>
  </BehaviorTree>
</root>
