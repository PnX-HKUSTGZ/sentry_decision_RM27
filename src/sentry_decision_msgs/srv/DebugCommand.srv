# 面板 service（结构化 service，而不是裸 topic）。
# command 取值与 args（JSON，YAML 子集）：
#   list_state:          {}                         # 返回 state_json 快照
#   set_tactical_mode:   {mode: retreat, lease_sec: 0}
#   clear_tactical_mode: {}
string command
string args
---
bool success
string message
# 仅 list_state 生效：命名点 / 资源 / 最近动作 / 动作回执 / 急停 / 战术层覆盖的 JSON 快照
string state_json